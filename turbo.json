{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/reference/prototype.html",
        "$TURBO_ROOT$/packages/shared/fixtures/**"
      ]
    }
  },
  "globalPassThroughEnv": ["CHROMIUM_PATH", "PLAYWRIGHT_BROWSERS_PATH"]
}
